--- !u!114 &644742632
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 644742631}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: a1a3b398e95346d43ba5cf2822bd6daa, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  kotakDialog: {fileID: 2122224897}
  teksDialog: {fileID: 439067168}
  daftarSlide:
  - objekGambar: {fileID: 388507365}
    teksNaratif: 
  - objekGambar: {fileID: 388507365}
    teksNaratif: '"Pada tanggal 23 Desember, telah terjadi kebakaran hebat di salah
      satu hutan di negeri ini. Kejadian tersebut merupakan ulah salah satu oknum
      pemerintahan setempat."'
  - objekGambar: {fileID: 1238146364}
    teksNaratif: '"Kebakaran tersebut membuat daerah sekitar hutan menjadi sesak
      dan beracun."'
  - objekGambar: {fileID: 1133563602}
    teksNaratif: 
  - objekGambar: {fileID: 1224701365}
    teksNaratif: '"Seorang penjaga hutan setempat yang biasa dipanggil PAMAN, memanggil
      keponakannya yang merupakan mahasiswa kehutanan untuk datang membantu mengurus
      hutan agar kembali sehat dan asri.'
  - objekGambar: {fileID: 350993163}
    teksNaratif: '"Yang tidak diketahui oleh Paman, keponakannya yang bernama SAKA
      sedang berada di fase tidak ingin diganggu siapa pun. Ia adalah mahasiswa kehutanan
      semester 8 yang harus segera menyelesaikan skripsinya."'
  - objekGambar: {fileID: 2073455817}
    teksNaratif: '"Ia harus menyerahkan skripsinya sebelum dosen pembimbingnya pergi
      liburan ke luar negeri. Namun apa daya... kekuatan Paman jauh lebih besar."'
  - objekGambar: {fileID: 290283561}
    teksNaratif: 
  kecepatanKetik: 0.04
  jedaSetelahSelesai: 2.5
  durasiGambarPolos: 2
  sceneBerikutnya: MainInGame
